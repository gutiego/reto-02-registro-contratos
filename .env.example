# Proveedor del modelo (por ahora: anthropic)
LLM_PROVIDER=anthropic
# Clave del proveedor. Nunca se sube al repositorio.
ANTHROPIC_API_KEY=
# Modelo a usar
LLM_MODEL=claude-opus-5-5
# Timeout por llamada al modelo (ms)
LLM_TIMEOUT_MS=60000
# Tope de iteraciones herramienta -> modelo por turno
MAX_ITERACIONES=25
# Tope de tokens (entrada + salida) por sesion
MAX_TOKENS_SESION=400000
# Fecha de referencia por defecto para alertas (YYYY-MM-DD)
FECHA_REFERENCIA=2026-09-03
# Puerto HTTP
PORT=3000
# Directorio de salida (en Vercel seria /tmp/out)
OUT_DIR=out
